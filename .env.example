# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill it in. `.env.local` is gitignored and
#  must never be committed. On Vercel, add the same variables under
#  Project → Settings → Environment Variables (all three environments).
# ─────────────────────────────────────────────────────────────────────────────


# ── The one login ────────────────────────────────────────────────────────────
# The whole account. There is no users table and no Supabase Auth: signing in
# compares against these two values and nothing else.
#
# AUTH_PASSWORD_HASH is a bcrypt hash; the plaintext is never stored. Generate
# one with:
#
#     npm run hash -- 'your password'
#
# IMPORTANT: the two places it goes want two different spellings, and the
# command prints both:
#
#   here, in a .env file    escaped:  AUTH_PASSWORD_HASH=\$2b\$12\$abc…
#                           A .env file is parsed by dotenv, which expands
#                           `$name` as a variable reference. A bare bcrypt hash
#                           is full of `$`, so it silently becomes an EMPTY
#                           string. Quoting does not help, since expansion
#                           happens inside single and double quotes alike.
#                           Escaping does.
#
#   Vercel / a shell        raw:      $2b$12$abc…
#                           No .env parsing happens, so it is taken literally.
#
# The app strips stray backslashes, so the escaped form also works where the raw
# one is expected. `npm run db:check` tells you if the value arrived mangled.
#
# Changing this hash signs out every existing session, because the session
# cookie is signed with a key derived from it (src/lib/auth.js).
AUTH_USERNAME=
AUTH_PASSWORD_HASH=


# ── Session signing ──────────────────────────────────────────────────────────
# Signs the login cookie (a JWT). Any long random string; rotating it also signs
# everyone out immediately. Generate one with:
#
#     openssl rand -hex 32
#     # or
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Required in production. In local development a fixed insecure fallback is used
# if this is unset, so `npm run dev` works before you have generated one.
AUTH_JWT_SECRET=


# ── Supabase (where the tasks live) ──────────────────────────────────────────
# Dashboard → Project Settings → API.
#
# The URL is public. The SERVICE ROLE key is NOT: it bypasses Row Level Security
# and is the only thing that can read this database (see supabase/schema.sql).
# It is used server-side only: never import src/lib/supabaseServer.js from a
# client component, and never prefix this variable with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ── Google Calendar (optional) ───────────────────────────────────────────────
# Leave these blank and nothing changes: /today works exactly as it did, with no
# Connect button and no Google requests.
#
# Filled in, /today's timeline draws your real calendar behind your plan
# (read-only, in Google's own colours), and finishing the day writes the blocks
# you placed back to your primary calendar.
#
# Get them from https://console.cloud.google.com:
#
#   1. Create a project, then APIs & Services → Library → enable "Google
#      Calendar API".
#   2. APIs & Services → OAuth consent screen. "External" is right for a
#      personal @gmail.com account; add yourself under Test users, and that is
#      enough — an app in testing needs no verification, it just has to be
#      re-consented every six months.
#   3. Credentials → Create credentials → OAuth client ID → Web application.
#      Under "Authorized redirect URIs" add BOTH of these, exactly:
#
#          http://localhost:3000/api/google/callback
#          https://<your-app>.vercel.app/api/google/callback
#
#      Google matches these character for character. A missing /api, a trailing
#      slash or http where you deployed https is the "redirect_uri_mismatch"
#      screen, and it is always this.
#   4. Copy the client id and secret below.
#
# Then sign in, open /today, and press "Connect Google" in the timeline's
# header. The grant is stored server-side in app_settings; no Google token ever
# reaches the browser, which is why neither of these is NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WHICH CALENDAR the finished day is written to, by name. It is never your main
# calendar: the plan goes in one of its own, so it is one checkbox away from
# being hidden and never mixed in with the meetings other people booked.
#
# Leave blank for the default, "Personal / Work". Whatever it says, a calendar
# with exactly that name has to exist in your Google account (Google Calendar →
# Other calendars → + → Create new calendar) or the send will fail and say so.
# It is matched ignoring case and stray spaces, and it does NOT have to be one
# of the calendars you have ticked.
GOOGLE_CALENDAR_NAME=

# Only needed if the app sits behind something that rewrites the host, so it
# cannot work out its own public URL. Left blank, the redirect is derived from
# the request — which is what lets one OAuth client serve localhost and
# production at once. If you set it, it must be one of the URIs registered
# above, exactly.
GOOGLE_REDIRECT_URI=
